# ============================================================
# Laravel .gitignore — Dental UK Dynamic
# ============================================================

# ----- Environment & Secrets --------------------------------
.env
.env.*
!.env.example
/auth.json

# ----- Dependencies -----------------------------------------
/vendor
/node_modules

# ----- Build Outputs ----------------------------------------
/public/build
/public/hot
/public/storage

# ----- Storage (user uploads & generated files) -------------
/storage/*.key
/storage/pail
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# ----- Cache & Compiled Files -------------------------------
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# ----- Testing ----------------------------------------------
.phpunit.result.cache
/.phpunit.cache
/coverage
*.code-coverage

# ----- IDE & Editor Files -----------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
.fleet/
.nova/
.zed/
.phpactor.json
*.swp
*.swo
*~

# ----- OS Files ---------------------------------------------
Desktop.ini
ehthumbs.db

# ----- Laravel Homestead ------------------------------------
Homestead.json
Homestead.yaml
.vagrant/

# ----- Logs -------------------------------------------------
*.log
npm-debug.log*
yarn-error.log

# ----- Misc -------------------------------------------------
.sass-cache/
/public/css/app.css
/public/js/app.js
